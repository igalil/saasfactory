{
  "name": "saasfactory",
  "version": "0.1.0",
  "description": "A desktop tool for capturing and evaluating SaaS ideas with subscription AI accounts",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "saasfactory": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json",
    "lint": "eslint src/",
    "test": "vitest",
    "prepublishOnly": "bun run build && bun run test:run",
    "desktop:dev": "node scripts/desktop-dev.mjs --main-only",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:start": "electron dist-desktop/main/main.js",
    "desktop:package": "bun run desktop:build && electron-builder",
    "desktop:package:local": "bun run desktop:build && electron-builder --mac --dir --config.mac.identity=- --config.mac.notarize=false --config.directories.output=release/local",
    "desktop:preview": "vite",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:provider": "bun run scripts/provider-smoke.ts"
  },
  "keywords": [
    "saas",
    "boilerplate",
    "generator",
    "nextjs",
    "convex",
    "clerk",
    "stripe",
    "cli",
    "ai",
    "claude",
    "typescript",
    "tailwind",
    "shadcn"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/igalil/saasfactory.git"
  },
  "bugs": {
    "url": "https://github.com/igalil/saasfactory/issues"
  },
  "homepage": "https://github.com/igalil/saasfactory#readme",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@clack/prompts": "^0.11.0",
    "@cursor/sdk": "^1.0.32",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@openai/codex-sdk": "^0.156.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ejs": "^3.1.10",
    "execa": "^9.5.2",
    "fs-extra": "^11.2.0",
    "lucide-react": "^1.47.0",
    "ora": "^8.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "agent-browser": "^0.38.1",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.8",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^2.1.9"
  }
}
